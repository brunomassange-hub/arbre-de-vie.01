{
  "name": "PositiveLink",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de la personne"
    },
    "type": {
      "type": "string",
      "enum": [
        "Famille",
        "Ami(e)",
        "Partenaire",
        "Mentor",
        "Coll\u00e8gue",
        "Autre"
      ],
      "description": "Type de lien"
    },
    "description": {
      "type": "string",
      "description": "Ce que cette relation vous apporte de positif"
    },
    "emotion": {
      "type": "string",
      "description": "\u00c9motion positive associ\u00e9e \u00e0 cette relation (lumi\u00e8re du chakra)"
    },
    "need_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Besoins fondamentaux combl\u00e9s par cette relation (format need:itemId)"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}