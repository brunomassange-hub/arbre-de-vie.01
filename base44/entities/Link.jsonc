{
  "name": "Link",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de la personne"
    },
    "type": {
      "type": "string",
      "enum": [
        "Famille",
        "Ami(e)",
        "Partenaire",
        "Mentor",
        "Coll\u00e8gue",
        "Autre"
      ],
      "description": "Type de lien"
    },
    "description": {
      "type": "string",
      "description": "Description libre de ce lien"
    },
    "emotion": {
      "type": "string",
      "description": "\u00c9motion principale associ\u00e9e \u00e0 cette relation (ombre du chakra)"
    },
    "soul_wound": {
      "type": "string",
      "enum": [
        "Trahison",
        "Rejet",
        "Abandon",
        "Humiliation",
        "Injustice"
      ],
      "description": "Blessure de l'\u00e2me principale associ\u00e9e \u00e0 cette relation"
    },
    "need_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Besoins fondamentaux troubl\u00e9s par cette relation (format need:itemId)"
    },
    "clinical_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cat\u00e9gories cliniques s\u00e9lectionn\u00e9es (format listId:itemId)"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}